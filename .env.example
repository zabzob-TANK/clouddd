# =============================================================================
# Module de facturation Zemzem Asfar — variables d'environnement
# =============================================================================
#
# Copier ce fichier en `.env.local` et renseigner les valeurs.
# `.env.local` est ignoré par Git : aucun secret ne doit être versionné.
#
# ⚠️ Ne jamais renseigner ici les identifiants du projet Supabase officiel
#    d'Omra. Ce dépôt est un test parallèle et doit rester sur un projet dédié.
# =============================================================================

# Source de données du module.
#   demo      — adaptateur en mémoire, aucun secret nécessaire (valeur par défaut)
#   supabase  — projet Supabase de test dédié à cette reconstruction
FACTURATION_SOURCE=demo

# Scénario du jeu de démonstration (sans effet si FACTURATION_SOURCE=supabase).
#   standard   — les six reçus caractéristiques (valeur par défaut)
#   pagination — ajoute une journée chargée servant uniquement à vérifier
#                l'impression du journal financier sur plusieurs pages
# FACTURATION_DEMO_SCENARIO=pagination

# -----------------------------------------------------------------------------
# Requis uniquement lorsque FACTURATION_SOURCE=supabase
# -----------------------------------------------------------------------------

# URL du projet Supabase de test.
NEXT_PUBLIC_SUPABASE_URL=

# Clé anonyme publique du projet de test.
# Destinée au navigateur : elle ne protège rien par elle-même, la sécurité
# repose sur les politiques de sécurité au niveau des lignes.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clé de service, côté serveur uniquement.
# Ne jamais l'exposer au navigateur ni la préfixer par NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Nom du bucket de stockage des images de chèques, virements et passeports.
FACTURATION_BUCKET=facturation
